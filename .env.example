# Security
SECRET_KEY=django-insecure-change-this-in-production-key-for-aaditya-portal-2026!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# Database Configuration (PostgreSQL in Docker / SQLite fallback)
USE_SQLITE=True
DB_NAME=supplier_portal_db
